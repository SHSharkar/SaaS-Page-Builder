#!/bin/sh
set -eu

msg_file="${1:-}"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  printf '[FAILED] Commit message file path is required\n' >&2
  exit 1
fi

first_line=$(head -n 1 "$msg_file")
case "$first_line" in
  Merge\ * | Revert\ *)
    exit 0
    ;;
esac

if ! printf '%s\n' "$first_line" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore)(\([a-z0-9._-]+\))?!?: .+'; then
  printf '[FAILED] Commit subject must follow Conventional Commits (e.g. feat(editor): add block studio)\n' >&2
  exit 1
fi
