{
  "name": "saas-page-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "description": "Multi-tenant SaaS landing page builder and publishing platform on Bun, Next.js 16, Drizzle ORM, PostgreSQL 18, Valkey, and Better Auth.",
  "scripts": {
    "dev": "bun --bun next dev",
    "dev:all": "./scripts/local.sh dev",
    "worker": "bun scripts/worker.ts",
    "worker:dev": "bun --watch scripts/worker.ts",
    "stripe:listen": "bun scripts/dev-stripe-listen.ts",
    "build": "bun --bun next build",
    "start": "bun scripts/start-server.ts",
    "typecheck": "bunx --bun tsc --noEmit",
    "lint": "bunx --bun eslint . --max-warnings 0",
    "lint:fix": "bunx --bun eslint . --fix --max-warnings 0",
    "lint:css": "bunx --bun stylelint \"**/*.css\"",
    "lint:css:fix": "bunx --bun stylelint \"**/*.css\" --fix",
    "format": "bunx --bun prettier --write .",
    "format:check": "bunx --bun prettier --check .",
    "test": "bunx --bun vitest run",
    "test:coverage": "bunx --bun vitest run --coverage",
    "test:e2e": "bunx --bun playwright test",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bun --conditions react-server scripts/migrate.ts",
    "db:seed:development": "bun scripts/seed-all.ts",
    "db:seed:keys": "bun scripts/seed-env-keys.ts",
    "db:seed:settings": "bun scripts/seed-settings.ts",
    "db:seed:production": "bun scripts/seed-production.ts",
    "db:restore": "bun scripts/restore-backup.ts",
    "db:replay-erasure-log": "bun scripts/replay-erasure-log.ts",
    "db:purge-keep-window": "bun scripts/purge-keep-window.ts",
    "backup:decrypt": "bun scripts/decrypt-backup.ts",
    "preflight": "bun scripts/preflight.ts",
    "verify": "VERIFY_TRIGGER=manual bun scripts/verify-gate.ts",
    "verify:fix": "bun run lint:fix && bun run lint:css:fix && bun scripts/verify-wording.ts --fix && bun run format && bun run verify",
    "verify:log": "bun scripts/verify-log.ts",
    "verify:contrast": "bun scripts/verify-color-contrast.ts",
    "verify:migrations": "bun scripts/verify-migrations.ts",
    "verify:migration-safety": "bun scripts/verify-migration-safety.ts",
    "verify:rls": "bun scripts/verify-rls.ts",
    "verify:authz": "bun scripts/verify-authz.ts",
    "verify:capabilities": "bun scripts/verify-capabilities.ts",
    "verify:roles": "bun scripts/verify-roles.ts",
    "verify:naming": "bun scripts/verify-naming.ts",
    "verify:tenant-delete": "bun scripts/verify-tenant-delete.ts",
    "verify:queue-policies": "bun scripts/verify-queue-policies.ts",
    "verify:message-catalog": "bun scripts/verify-message-catalog.ts",
    "verify:unused": "bunx --bun knip",
    "verify:audit": "bun scripts/verify-audit.ts",
    "verify:licenses": "bun scripts/verify-licenses.ts",
    "verify:wording": "bun scripts/verify-wording.ts",
    "verify:shell": "bun scripts/verify-shell.ts",
    "verify:deps": "bunx --bun depcruise --config .dependency-cruiser.mjs app components hooks lib scripts",
    "verify:client-boundary": "bun scripts/verify-client-boundary.ts",
    "sbom": "bunx @cdxgen/cdxgen -o sbom.cdx.json",
    "prepare": "husky",
    "verify:fast": "VERIFY_TIER=fast bun scripts/verify-gate.ts",
    "verify:code": "VERIFY_TIER=code bun scripts/verify-gate.ts",
    "verify:schema": "VERIFY_TIER=schema bun scripts/verify-gate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@better-auth/passkey": "^1.7.12",
    "@node-rs/argon2": "^2.2.2",
    "@react-email/components": "^1.0.12",
    "better-auth": "^1.7.12",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "^18.7.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "esbuild": "^0.28.2",
    "follow-redirects": "^1.16.1",
    "happy-dom": "^21.0.4",
    "hono": "^4.13.13",
    "vite": "^8.3.5",
    "source-map-js": "^1.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "browserslist": [
    "Chrome >= 111",
    "Edge >= 111",
    "Firefox >= 128",
    "Safari >= 16.4"
  ]
}
